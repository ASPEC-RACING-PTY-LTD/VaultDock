# VaultDock configuration reference. install.sh writes a complete app/.env for you.
# Never commit your real .env.

# Host paths (absolute paths recommended). Put storage on your HDD/volume.
VAULTDOCK_STATE_PATH=./data/state
VAULTDOCK_STORAGE_PATH=./data/storage

# Container user that owns the data directories.
VAULTDOCK_UID=65532
VAULTDOCK_GID=65532

# Network
VAULTDOCK_BIND=0.0.0.0
VAULTDOCK_PORT=3000
VAULTDOCK_PUBLIC_URL=https://vault.example.com

# Required to create the first administrator in the web UI. Generate with:
#   openssl rand -hex 24
VAULTDOCK_SETUP_TOKEN=change-me

# HTTPS options (choose one):
# 1) Built-in Caddy with Let's Encrypt:
#COMPOSE_PROFILES=caddy
#VAULTDOCK_DOMAIN=vault.example.com
#VAULTDOCK_TRUSTED_PROXIES=172.16.0.0/12
# 2) Your own reverse proxy: set VAULTDOCK_TRUSTED_PROXIES to its address(es).
# 3) Self-signed certificate served directly (LAN): desktop app asks you to
#    verify and pin the fingerprint printed in the logs.
#VAULTDOCK_TLS_SELF_SIGNED=true
#VAULTDOCK_TLS_HOSTS=192.168.1.20,vault.lan

# Cookies: auto (Secure when HTTPS is detected), true or false.
VAULTDOCK_COOKIE_SECURE=auto

# Tuning
VAULTDOCK_CHUNK_SIZE_MB=8
VAULTDOCK_MAX_CONCURRENT_CHUNKS=64
VAULTDOCK_UPLOAD_TTL_HOURS=48
VAULTDOCK_LOG_LEVEL=info
VAULTDOCK_LOG_FORMAT=json

# Optional MaxMind/DB-IP city database for device request locations
# (mount it into /state and point here).
#VAULTDOCK_GEOIP_DB=/state/GeoLite2-City.mmdb

# Release checks shown in Admin console -> Updates (every 12 hours).
VAULTDOCK_UPDATE_CHECK=true
VAULTDOCK_UPDATE_REPO=ASPEC-RACING-PTY-LTD/VaultDock
# Managed by "install.sh auto-update on|off"; shown in the admin console.
VAULTDOCK_AUTO_UPDATE=off
